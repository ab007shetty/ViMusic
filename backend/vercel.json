{
  "version": 2,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/playlists/:id/songs/:songId",
      "destination": "/api/playlists/:id"
    },
    {
      "source": "/api/playlists/:id/songs",
      "destination": "/api/playlists/:id"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, x-user-email, Authorization" }
      ]
    }
  ]
}
